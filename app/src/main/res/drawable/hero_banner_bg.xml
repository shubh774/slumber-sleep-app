<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Deep Midnight Gradient Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#0D1117"
                android:centerColor="#162032"
                android:endColor="#1B2A4A"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 2. Subtle Moonlight Glow -->
    <item android:top="-50dp" android:right="-50dp" android:width="220dp" android:height="220dp">
        <shape android:shape="oval">
            <gradient
                android:gradientRadius="110dp"
                android:startColor="#3358A6FF"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>

</layer-list>
